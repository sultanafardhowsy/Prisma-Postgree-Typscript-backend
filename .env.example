# Server
PORT=5000
NODE_ENV=development

# PostgreSQL connection string
# Works with plain PostgreSQL, Supabase, NeonDB, or Prisma Postgres
# Example (NeonDB/Supabase pooled): postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL="postgresql://username:password@localhost:5432/fundflow_db"

# JWT
# Use a long, random string in production (e.g. `openssl rand -base64 48`)
JWT_SECRET="replace-this-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# CORS - comma separated list of allowed frontend origins (used if you tighten CORS later)
CLIENT_URL="http://localhost:3000"
